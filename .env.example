# Copy to .env and fill in. Never commit .env.

# Postgres from docker-compose.yml
DATABASE_URL=postgres://ops:ops@localhost:5432/operation_agents

# API
API_PORT=3000

# Shared secret the invoice sender uses to sign webhook bodies (HMAC-SHA256).
# Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=change-me

# Used from Day 1 step 3 onwards (agent + policy embeddings)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
