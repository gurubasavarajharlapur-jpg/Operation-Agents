# Copy to .env and fill in. Never commit .env.

# Postgres from docker-compose.yml
DATABASE_URL=postgres://ops:ops@localhost:5432/operation_agents

# The worker (which runs the agent) connects as a restricted user that cannot approve payments.
# npm run db:migrate sets this user's password from this URL.
WORKER_DATABASE_URL=postgres://ops_worker:ops_worker_dev@localhost:5432/operation_agents

# API
API_PORT=3000

# Shared secret the invoice sender uses to sign webhook bodies (HMAC-SHA256).
# Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=change-me

# Claude agent (optional: without it the worker runs in rules-only mode)
# and Voyage embeddings (optional: without it search_policy uses full-text search)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Worker. AGENT_MODE: auto (Claude if ANTHROPIC_API_KEY is set, else rules-only), llm, or rules
AGENT_MODE=auto
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
AGENT_MAX_TURNS=8
WORKER_CONCURRENCY=2

# Production / public demo (see DEPLOY.md). Locally you can leave these unset.
# DEMO_MODE=true                 # one-click demo sign-in and a "send sample invoice" panel
# DAILY_LLM_BUDGET_USD=2         # after this much Claude spend per day, fall back to rules-only
# WORKER_DB_PASSWORD=...         # alternative to WORKER_DATABASE_URL: same host as DATABASE_URL, user ops_worker
