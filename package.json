{
  "name": "operation-agents",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate -w @oa/db",
    "db:seed": "npm run seed -w @oa/db",
    "db:reset": "docker compose down -v && npm run db:up && npm run db:migrate && npm run db:seed",
    "dev:api": "npm run dev -w @oa/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "send:invoice": "tsx packages/api/scripts/send-invoice.ts",
    "db:embed": "npm run embed -w @oa/db",
    "dev:worker": "npm run dev -w @oa/worker",
    "operator:token": "npm run operator:token -w @oa/db",
    "dev:web": "npm run dev -w @oa/web",
    "test:e2e": "npm run test:e2e -w @oa/web",
    "build": "npm run build -w @oa/web"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
